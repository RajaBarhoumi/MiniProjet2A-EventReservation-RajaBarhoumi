{% extends 'admin/base.html.twig' %}

{% block title %}Events{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Events</h2>
        <small class="text-muted">{{ events|length }} total events</small>
    </div>
    <a href="{{ path('admin_events_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> New Event
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 60px;">#</th>
                    <th style="width: 80px;">Image</th>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Location</th>
                    <th>Seats</th>
                    <th>Available</th>
                    <th>Reservations</th>
                    <th style="width: 150px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for event in events %}
                <tr>
                    <td class="text-muted small">{{ loop.index }}</td>
                    <td>
                        {% if event.image %}
                            <img src="/uploads/events/{{ event.image }}"
                                 style="width: 50px; height: 40px; object-fit: cover;"
                                 class="rounded">
                        {% else %}
                            <div class="bg-secondary rounded d-flex align-items-center
                                        justify-content-center"
                                 style="width: 50px; height: 40px;">
                                <i class="bi bi-image text-white small"></i>
                            </div>
                        {% endif %}
                    </td>
                    <td>
                        <span class="fw-semibold">{{ event.title }}</span>
                        <br>
                        <small class="text-muted">
                            {{ event.description|slice(0, 60) }}...
                        </small>
                    </td>
                    <td>
                        <span>{{ event.date|date('d/m/Y') }}</span>
                        <br>
                        <small class="text-muted">{{ event.date|date('H:i') }}</small>
                    </td>
                    <td>
                        <i class="bi bi-geo-alt text-muted me-1"></i>
                        {{ event.location }}
                    </td>
                    <td>{{ event.seats }}</td>
                    <td>
                        {% set available = event.availableSeats %}
                        {% if available <= 0 %}
                            <span class="badge bg-danger">Full</span>
                        {% elseif available <= 10 %}
                            <span class="badge bg-warning text-dark">{{ available }} left</span>
                        {% else %}
                            <span class="badge bg-success">{{ available }} left</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('admin_events_reservations', {id: event.id}) }}"
                           class="badge bg-info text-decoration-none text-white">
                            <i class="bi bi-people me-1"></i>
                            {{ event.reservations|length }}
                        </a>
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a href="{{ path('admin_events_edit', {id: event.id}) }}"
                               class="btn btn-sm btn-outline-secondary"
                               title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="{{ path('admin_events_reservations', {id: event.id}) }}"
                               class="btn btn-sm btn-outline-info"
                               title="View Reservations">
                                <i class="bi bi-eye"></i>
                            </a>
                            <form method="post"
                                  action="{{ path('admin_events_delete', {id: event.id}) }}"
                                  class="d-inline"
                                  onsubmit="return confirm('Are you sure you want to delete {{ event.title }}?')">
                                <input type="hidden" name="_token"
                                       value="{{ csrf_token('delete-event-' ~ event.id) }}">
                                <button class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="9" class="text-center py-5">
                        <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
                        <p class="text-muted mb-3">No events found.</p>
                        <a href="{{ path('admin_events_new') }}" class="btn btn-primary btn-sm">
                            <i class="bi bi-plus-lg me-1"></i> Create First Event
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
