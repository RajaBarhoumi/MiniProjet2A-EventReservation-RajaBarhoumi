{% extends 'admin/base.html.twig' %}
{% block title %}Edit Event{% endblock %}
{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Edit Event</h2>
    <a href="{{ path('admin_events_index') }}" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form method="post" enctype="multipart/form-data">
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Title *</label>
                        <input type="text" name="title" class="form-control"
                               value="{{ event.title }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Description *</label>
                        <textarea name="description" class="form-control"
                                  rows="4" required>{{ event.description }}</textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Date *</label>
                            <input type="datetime-local" name="date" class="form-control"
                                   value="{{ event.date|date('Y-m-d\\TH:i') }}" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Seats *</label>
                            <input type="number" name="seats" class="form-control"
                                   value="{{ event.seats }}" min="1" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Location *</label>
                        <input type="text" name="location" class="form-control"
                               value="{{ event.location }}" required>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Event Image</label>
                        {% if event.image %}
                            <img src="/uploads/events/{{ event.image }}"
                                 class="img-fluid rounded mb-2">
                        {% endif %}
                        <input type="file" name="image" class="form-control" accept="image/*">
                        <small class="text-muted">Leave empty to keep current image</small>
                    </div>
                </div>
            </div>
            <hr>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> Save Changes
            </button>
        </form>
    </div>
</div>
{% endblock %}
