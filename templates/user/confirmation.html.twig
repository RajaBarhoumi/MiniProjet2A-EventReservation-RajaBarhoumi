{% extends 'user/base.html.twig' %}
{% block title %}Reservation Confirmed!{% endblock %}
{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm p-5">
                <div class="mb-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex
                                align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">
                        <i class="bi bi-check-lg text-success fs-1"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-success">Reservation Confirmed!</h2>
                <p class="text-muted mt-2">
                    Thank you <strong>{{ reservation.name }}</strong>!
                    Your spot at <strong>{{ event.title }}</strong> is reserved.
                </p>

                <div class="card bg-light border-0 p-3 mt-4 text-start">
                    <div class="row g-2 small">
                        <div class="col-5 text-muted">Event</div>
                        <div class="col-7 fw-semibold">{{ event.title }}</div>
                        <div class="col-5 text-muted">Date</div>
                        <div class="col-7">{{ event.date|date('d M Y, H:i') }}</div>
                        <div class="col-5 text-muted">Location</div>
                        <div class="col-7">{{ event.location }}</div>
                        <div class="col-5 text-muted">Email</div>
                        <div class="col-7">{{ reservation.email }}</div>
                    </div>
                </div>

                <a href="{{ path('home') }}" class="btn btn-primary mt-4">
                    <i class="bi bi-arrow-left me-2"></i>Back to Events
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
