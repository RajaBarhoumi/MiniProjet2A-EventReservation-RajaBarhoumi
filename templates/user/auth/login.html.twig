{% extends 'user/base.html.twig' %}
{% block title %}Login{% endblock %}

{% block content %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-sm p-4">
                <h3 class="text-center mb-4">Login</h3>

                {% if error %}
                    <div class="alert alert-danger">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <form method="post" action="{{ path('user_login') }}">
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="_username" class="form-control"
                               value="{{ last_username }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input type="password" name="_password" class="form-control" required>
                    </div>
                    <input type="hidden" name="_csrf_token"
                           value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>

                <div class="text-center my-3 text-muted">— or —</div>

                <button id="passkeyLoginBtn" class="btn btn-outline-dark w-100">
                    <i class="bi bi-fingerprint me-2"></i>Login with Passkey
                </button>

                <p class="text-center text-muted mt-3 small">
                    No account? <a href="{{ path('user_register') }}">Register</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
{# Load auth.js FIRST before any inline script #}
<script src="/js/auth.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const btn = document.getElementById('passkeyLoginBtn');

        // Check if browser supports WebAuthn
        if (!window.PublicKeyCredential) {
            btn.disabled = true;
            btn.textContent = 'Passkey not supported in this browser';
            return;
        }

        btn.addEventListener('click', async () => {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Authenticating...';
            try {
                const result = await loginWithPasskey();
                if (result.token) {
                    window.location.href = '/';
                }
            } catch (e) {
                alert('Passkey login failed: ' + e.message);
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-fingerprint me-2"></i>Login with Passkey';
            }
        });
    });
</script>
{% endblock %}